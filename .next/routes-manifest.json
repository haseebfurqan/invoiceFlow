{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/clients/[id]",
      "regex": "^/api/clients/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/clients/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/invoices/[id]",
      "regex": "^/api/invoices/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/invoices/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/invoices/[id]/pdf",
      "regex": "^/api/invoices/([^/]+?)/pdf(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/invoices/(?<nxtPid>[^/]+?)/pdf(?:/)?$"
    },
    {
      "page": "/api/invoices/[id]/send",
      "regex": "^/api/invoices/([^/]+?)/send(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/invoices/(?<nxtPid>[^/]+?)/send(?:/)?$"
    },
    {
      "page": "/api/items/[id]",
      "regex": "^/api/items/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/items/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/invoices/[id]",
      "regex": "^/invoices/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/invoices/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/clients",
      "regex": "^/api/clients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/clients(?:/)?$"
    },
    {
      "page": "/api/invoices",
      "regex": "^/api/invoices(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/invoices(?:/)?$"
    },
    {
      "page": "/api/items",
      "regex": "^/api/items(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/items(?:/)?$"
    },
    {
      "page": "/api/settings",
      "regex": "^/api/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/settings(?:/)?$"
    },
    {
      "page": "/clients",
      "regex": "^/clients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clients(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/invoices/new",
      "regex": "^/invoices/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/invoices/new(?:/)?$"
    },
    {
      "page": "/items",
      "regex": "^/items(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/items(?:/)?$"
    },
    {
      "page": "/onboarding",
      "regex": "^/onboarding(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/onboarding(?:/)?$"
    },
    {
      "page": "/rules",
      "regex": "^/rules(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rules(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}